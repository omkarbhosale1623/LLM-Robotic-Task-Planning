# Backend configuration (copy to backend/.env and fill in real values).
# The app boots with the deterministic heuristic planner and in-memory
# persistence when the optional blocks below are left blank.

# -- App --------------------------------------------------------------------
APP_NAME=LLM Robotic Task-Planning Agent
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# -- Server / CORS ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list (or JSON array) of allowed front-end origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -- World ------------------------------------------------------------------
DEFAULT_SCENE=default

# -- Auth (Supabase JWT, always enforced) -----------------------------------
AUTH_REQUIRED=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# -- Persistence (Supabase Postgres; optional, import-guarded) --------------
# auto -> SQL when DATABASE_URL + libs are present, else in-memory.
PERSISTENCE_BACKEND=auto
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# -- Real-LLM planner (Mistral by default; heuristic fallback always works) --
ENABLE_LLM=true
# Backend: "mistral" (default) or "anthropic".
LLM_BACKEND=mistral
# Mistral (default). Get a key at https://console.mistral.ai/. Placeholder only:
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest
# Anthropic (alternative backend; selectable via LLM_BACKEND=anthropic):
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=2048

# -- Plan memory (pgvector few-shot retrieval; optional) --------------------
ENABLE_PLAN_MEMORY=true
PLAN_MEMORY_TOP_K=3
EMBEDDING_DIM=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
