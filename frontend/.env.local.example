# Frontend environment (copy to .env.local). All NEXT_PUBLIC_* are inlined into
# the browser bundle at build time — never put secret keys here (the anon key is
# safe to expose; the service-role key is NOT).

# Base URL of the FastAPI backend. The typed API client and WebSocket hook read this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase browser client (email/password login gate).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
