# Root-level shared example used by docker-compose. Copy to .env and fill in.
# Real secrets belong ONLY in the gitignored .env (never in this committed file).

# ---- Backend --------------------------------------------------------------
LOG_LEVEL=INFO
DEFAULT_SCENE=default

# Auth (Supabase JWT, always enforced)
AUTH_REQUIRED=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Persistence (Supabase Postgres; optional)
PERSISTENCE_BACKEND=auto
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Real-LLM planner (Mistral default; Anthropic alternative). Heuristic fallback always works.
ENABLE_LLM=true
LLM_BACKEND=mistral
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Frontend -------------------------------------------------------------
# Base URL the browser uses to reach the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Supabase browser client (anon key is safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
